{% comment %}
================================================================================
  Leafywell AI Assistant — Homepage Section
  File: sections/leafywell-homepage-assistant.liquid

  HOW TO INSTALL:
  1. Go to Shopify Admin → Online Store → Themes → Edit code
  2. In "Sections" folder → click "Add a new section"
  3. Name it: leafywell-homepage-assistant
  4. Paste this entire file → Save
  5. Go to Online Store → Customize (theme editor)
  6. Click "Add section" anywhere on the homepage
  7. Find "Leafywell AI Assistant" and add it
  8. Save

  SCHEMA SETTINGS (configurable in theme editor):
  - Section heading text
  - Subheading text
  - Background color (light/dark)
  - Show/hide featured product chips
================================================================================
{% endcomment %}

{% assign lw_proxy      = 'https://myiad-rag-app.vercel.app/api/chat' %}
{% assign lw_section_id = section.id | replace: '-', '' | truncate: 10, '' %}

<div
  id="lw-home-{{ lw_section_id }}"
  class="lw-home-section color-{{ section.settings.color_scheme }} gradient"
  style="padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">

    {{- '<!-- HEADER -->' }}
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div style="text-align:center;margin-bottom:28px;">
        {% if section.settings.heading != blank %}
          <h2 style="font-size:28px;font-weight:600;margin:0 0 8px;letter-spacing:0.02em;">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p style="font-size:15px;opacity:0.75;margin:0;max-width:580px;margin-inline:auto;line-height:1.6;">
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    {{- '<!-- ASSISTANT WIDGET -->' }}
    <div style="max-width:720px;margin:0 auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;">
      <div style="border:1px solid rgba(0,0,0,0.1);border-radius:16px;overflow:hidden;background:#fff;box-shadow:0 4px 24px rgba(0,0,0,0.06);">

        {{- '<!-- WIDGET HEADER -->' }}
        <div style="display:flex;align-items:center;gap:10px;padding:14px 18px;background:#f8fafc;border-bottom:1px solid #e2e8f0;">
          <div style="width:32px;height:32px;border-radius:50%;background:#2d6a4f;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round">
              <path d="M12 2C7 2 4 6 4 10c0 5 8 12 8 12s8-7 8-12c0-4-3-8-8-8z"/>
              <circle cx="12" cy="10" r="2.5" fill="#fff" stroke="none"/>
            </svg>
          </div>
          <div style="flex:1;">
            <div style="font-size:14px;font-weight:600;color:#0f172a;">{{ section.settings.widget_title | default: 'Ask Leafywell AI' }}</div>
            <div style="font-size:11px;color:#94a3b8;">Powered by Claude · Nature has a Remedy</div>
          </div>
          <div style="font-size:11px;padding:3px 10px;border-radius:20px;background:#dcfce7;color:#166534;border:1px solid #bbf7d0;">● Live</div>
        </div>

        {{- '<!-- MESSAGES -->' }}
        <div id="lw-home-msgs-{{ lw_section_id }}" style="padding:16px 18px;display:flex;flex-direction:column;gap:12px;min-height:80px;max-height:320px;overflow-y:auto;">
          <div style="display:flex;gap:10px;align-items:flex-start;">
            <div style="width:28px;height:28px;border-radius:50%;background:#2d6a4f;color:#fff;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:600;flex-shrink:0;">LW</div>
            <div style="background:#f1f5f9;border-radius:12px;border-top-left-radius:3px;padding:10px 14px;font-size:13px;color:#0f172a;max-width:85%;line-height:1.6;">
              {{ section.settings.greeting | default: "Hi! I'm Leafywell's AI assistant. Ask me about any of our supplements — ingredients, benefits, dosing, or help finding the right product for your goals." }}
            </div>
          </div>
        </div>

        {{- '<!-- QUICK CHIPS -->' }}
        {% if section.settings.show_chips %}
          <div id="lw-home-chips-{{ lw_section_id }}" style="display:flex;flex-wrap:wrap;gap:5px;padding:8px 18px;border-top:1px solid #f1f5f9;">
            <button onclick="lwHomeAsk{{ lw_section_id }}('What supplements do you have for energy and focus?')"
              style="font-size:11px;padding:5px 12px;border-radius:20px;border:1px solid #cbd5e1;background:#fff;color:#475569;cursor:pointer;"
              onmouseover="this.style.background='#e8f5ee';this.style.color='#1a5c38';"
              onmouseout="this.style.background='#fff';this.style.color='#475569';">
              Energy & focus
            </button>
            <button onclick="lwHomeAsk{{ lw_section_id }}('Which products are best for sleep and stress relief?')"
              style="font-size:11px;padding:5px 12px;border-radius:20px;border:1px solid #cbd5e1;background:#fff;color:#475569;cursor:pointer;"
              onmouseover="this.style.background='#e8f5ee';this.style.color='#1a5c38';"
              onmouseout="this.style.background='#fff';this.style.color='#475569';">
              Sleep & stress
            </button>
            <button onclick="lwHomeAsk{{ lw_section_id }}('What supplements support immune health and daily wellness?')"
              style="font-size:11px;padding:5px 12px;border-radius:20px;border:1px solid #cbd5e1;background:#fff;color:#475569;cursor:pointer;"
              onmouseover="this.style.background='#e8f5ee';this.style.color='#1a5c38';"
              onmouseout="this.style.background='#fff';this.style.color='#475569';">
              Immune support
            </button>
            <button onclick="lwHomeAsk{{ lw_section_id }}('What is the difference between your mineral and vitamin products?')"
              style="font-size:11px;padding:5px 12px;border-radius:20px;border:1px solid #cbd5e1;background:#fff;color:#475569;cursor:pointer;"
              onmouseover="this.style.background='#e8f5ee';this.style.color='#1a5c38';"
              onmouseout="this.style.background='#fff';this.style.color='#475569';">
              Minerals vs vitamins
            </button>
            <button onclick="lwHomeAsk{{ lw_section_id }}('Are your products vegan, non-GMO and made in the USA?')"
              style="font-size:11px;padding:5px 12px;border-radius:20px;border:1px solid #cbd5e1;background:#fff;color:#475569;cursor:pointer;"
              onmouseover="this.style.background='#e8f5ee';this.style.color='#1a5c38';"
              onmouseout="this.style.background='#fff';this.style.color='#475569';">
              Certifications
            </button>
          </div>
        {% endif %}

        {{- '<!-- INPUT ROW -->' }}
        <div style="display:flex;gap:8px;padding:10px 18px 14px;border-top:1px solid #e2e8f0;">
          <input
            type="text"
            id="lw-home-input-{{ lw_section_id }}"
            placeholder="Ask about any supplement, ingredient, or goal..."
            onkeydown="if(event.key==='Enter')lwHomeSend{{ lw_section_id }}()"
            style="flex:1;font-size:13px;padding:9px 14px;border-radius:10px;border:1px solid #cbd5e1;color:#0f172a;outline:none;background:#fff;"
            onfocus="this.style.borderColor='#2d6a4f'"
            onblur="this.style.borderColor='#cbd5e1'"
          >
          <button
            id="lw-home-btn-{{ lw_section_id }}"
            onclick="lwHomeSend{{ lw_section_id }}()"
            style="padding:9px 18px;border-radius:10px;border:none;background:#2d6a4f;color:#fff;font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;"
            onmouseover="this.style.opacity='0.85'"
            onmouseout="this.style.opacity='1'"
          >Ask →</button>
        </div>

        {{- '<!-- FDA -->' }}
        <div style="padding:0 18px 12px;font-size:10px;color:#94a3b8;line-height:1.4;">
          *These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.
        </div>

      </div>
    </div>

  </div>
</div>

<style>
  #lw-home-msgs-{{ lw_section_id }}::-webkit-scrollbar{width:4px}
  #lw-home-msgs-{{ lw_section_id }}::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
  @keyframes lwHomeBounce{{ lw_section_id }}{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-4px)}}
</style>

<script>
(function(){
  var PROXY = {{ lw_proxy | json }};
  var sid   = '{{ lw_section_id }}';
  var history = [];

  function addMsg(role, html) {
    var msgs = document.getElementById('lw-home-msgs-' + sid);
    var wrap = document.createElement('div');
    wrap.style.cssText = 'display:flex;gap:10px;align-items:flex-start;' + (role==='user' ? 'flex-direction:row-reverse;' : '');
    var av = document.createElement('div');
    av.style.cssText = 'width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:600;flex-shrink:0;';
    if (role==='user') { av.style.background='#dbeafe'; av.style.color='#1e40af'; av.textContent='You'; }
    else { av.style.background='#2d6a4f'; av.style.color='#fff'; av.textContent='LW'; }
    var bubble = document.createElement('div');
    bubble.style.cssText = 'border-radius:12px;padding:10px 14px;font-size:13px;line-height:1.6;max-width:85%;' +
      (role==='user' ? 'background:#2d6a4f;color:#fff;border-top-right-radius:3px;' : 'background:#f1f5f9;color:#0f172a;border-top-left-radius:3px;');
    bubble.innerHTML = html;
    wrap.appendChild(av);
    wrap.appendChild(bubble);
    msgs.appendChild(wrap);
    msgs.scrollTop = 99999;
    return wrap;
  }

  function typing() {
    return addMsg('ai',
      '<span style="display:inline-flex;gap:3px;align-items:center;height:16px;">' +
      '<span style="width:5px;height:5px;border-radius:50%;background:#94a3b8;animation:lwHomeBounce'+sid+' 1.2s infinite;"></span>' +
      '<span style="width:5px;height:5px;border-radius:50%;background:#94a3b8;animation:lwHomeBounce'+sid+' 1.2s infinite 0.2s;"></span>' +
      '<span style="width:5px;height:5px;border-radius:50%;background:#94a3b8;animation:lwHomeBounce'+sid+' 1.2s infinite 0.4s;"></span>' +
      '</span>');
  }

  window['lwHomeAsk' + sid] = function(q) {
    document.getElementById('lw-home-input-' + sid).value = q;
    window['lwHomeSend' + sid]();
  };

  window['lwHomeSend' + sid] = async function() {
    var input = document.getElementById('lw-home-input-' + sid);
    var btn   = document.getElementById('lw-home-btn-' + sid);
    var q = input.value.trim();
    if (!q) return;
    input.value = '';
    btn.disabled = true;
    btn.style.opacity = '0.4';
    addMsg('user', q);
    history.push({ role: 'user', content: q });
    var t = typing();
    try {
      var res = await fetch(PROXY, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          question: q,
          staticContext: 'This is a general Leafywell store inquiry. Leafywell is a veteran-owned supplement brand offering medical-grade, USA-made, 3rd-party tested supplements including minerals, vitamins, nootropics, digestive health, and wellness products. Answer questions about products, ingredients, benefits, and general wellness guidance. If asked about a specific product, refer the customer to the product page for detailed information.',
          history: history.slice(-8)
        })
      });
      var data = await res.json();
      var answer = data.answer || 'I could not get a response. Please try again.';
      t.remove();
      history.push({ role: 'assistant', content: answer });
      var fmt = answer
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\n\n/g, '<br><br>')
        .replace(/\n/g, '<br>');
      addMsg('ai', fmt);
    } catch(e) {
      t.remove();
      addMsg('ai', 'Something went wrong. Please try again.');
    }
    btn.disabled = false;
    btn.style.opacity = '1';
    input.focus();
  };
})();
</script>

{% schema %}
{
  "name": "Leafywell AI Assistant",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "accent-1",     "label": "Accent 1" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Ask Our AI Supplement Advisor"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Get personalized supplement guidance powered by Claude AI — ingredients, benefits, and the right product for your goals."
    },
    {
      "type": "text",
      "id": "widget_title",
      "label": "Widget title",
      "default": "Ask Leafywell AI"
    },
    {
      "type": "textarea",
      "id": "greeting",
      "label": "Opening greeting message",
      "default": "Hi! I'm Leafywell's AI assistant. Ask me about any of our supplements — ingredients, benefits, dosing, or help finding the right product for your goals."
    },
    {
      "type": "checkbox",
      "id": "show_chips",
      "label": "Show quick-question chips",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0, "max": 100, "step": 4, "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0, "max": 100, "step": 4, "default": 40,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Leafywell AI Assistant"
    }
  ]
}
{% endschema %}
