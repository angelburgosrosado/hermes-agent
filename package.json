{
  "name": "claudeclaw",
  "version": "2.0.0",
  "description": "ClaudeClaw OS — Personal AI assistant powered by Claude Code",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "warroom": "python3 warroom/server.py",
    "dashboard": "tsx src/dashboard.ts",
    "agent:create": "tsx src/agent-create-cli.ts",
    "schedule": "node dist/schedule-cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.34",
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/genai": "^1.44.0",
    "@hono/node-server": "^1.13.7",
    "@slack/web-api": "^7.9.1",
    "@supermemory/tools": "^2.0.0",
    "agent-browser": "^0.26.0",
    "anthropic": "^0.0.0",
    "better-sqlite3": "^11.10.0",
    "cron-parser": "^4.9.0",
    "grammy": "^1.34.0",
    "hono": "^4.7.7",
    "js-yaml": "^4.1.0",
    "openai": "^6.35.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.1-alpha.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
