# ClaudeClaw OS — Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# CORE — Required
# =============================================================================

# Anthropic API key (for Claude Code CLI and direct API calls)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Allowed Telegram chat ID (your personal chat ID — leave empty for any)
ALLOWED_CHAT_ID=

# Comma-separated Telegram user IDs or usernames allowed to use the bot
TELEGRAM_ALLOWED_USERS=

# =============================================================================
# MEMORY v2 — Gemini embeddings
# =============================================================================

# Google AI Studio API key — for Gemini extraction + text-embedding-004
GOOGLE_API_KEY=
GEMINI_API_KEY=    # alias for GOOGLE_API_KEY

# =============================================================================
# VOICE — STT + TTS
# =============================================================================

# Groq API key — Whisper STT (fast, free tier available)
GROQ_API_KEY=
STT_GROQ_MODEL=whisper-large-v3-turbo

# ElevenLabs TTS (optional — best quality)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Kokoro TTS (optional — local, self-hosted)
KOKORO_URL=

# =============================================================================
# WAR ROOM (Voice Boardroom)
# =============================================================================

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
WARROOM_PORT=7860
WARROOM_MODE=production  # legacy | production

# =============================================================================
# DASHBOARD
# =============================================================================

DASHBOARD_PORT=3141
DASHBOARD_TOKEN=   # Leave empty for open access (dev only)

# =============================================================================
# SECURITY
# =============================================================================

# PIN hash: generate with: echo -n "salt:$(echo -n 'salt+PIN' | sha256sum | cut -d' ' -f1)"
PIN_HASH=

# Phrase to trigger emergency shutdown (exact match, case-insensitive)
KILL_PHRASE=

# Minutes of inactivity before auto-lock (0 = disabled)
IDLE_LOCK_MINUTES=30

# AES-256-GCM key for encrypting WhatsApp messages in DB
DB_ENCRYPTION_KEY=change-this-to-a-strong-secret-key

# =============================================================================
# MULTI-AGENT
# =============================================================================

# Fallback LLM provider
OPENROUTER_API_KEY=

# Per-agent Telegram bot tokens (optional — separate bots per agent)
COMMS_TELEGRAM_TOKEN=
CONTENT_TELEGRAM_TOKEN=
OPS_TELEGRAM_TOKEN=
RESEARCH_TELEGRAM_TOKEN=

# =============================================================================
# WHATSAPP BRIDGE
# =============================================================================

# Comma-separated phone numbers allowed to message the bot (e.g. 15551234567)
WHATSAPP_ALLOWED_USERS=

# =============================================================================
# MEETING BOT
# =============================================================================

PIKA_API_KEY=
RECALL_API_KEY=

# =============================================================================
# INTEGRATIONS
# =============================================================================

SLACK_BOT_TOKEN=

# =============================================================================
# AGENT BEHAVIOR
# =============================================================================

AGENT_TIMEOUT_MS=900000
AGENT_MAX_TURNS=30
SHOW_COST_FOOTER=compact   # off | compact | verbose | cost | full
STREAM_STRATEGY=off        # off | global-throttle | single-agent-only
MEMORY_NUDGE_INTERVAL_TURNS=10
MEMORY_NUDGE_INTERVAL_HOURS=2
LOG_LEVEL=info
